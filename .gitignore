# Root level gitignore

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Local Docker Compose overrides (machine-specific port/volume tweaks)
docker/docker-compose.override.yml

# Local/production config that may hold secrets. Secrets belong in
# `dotnet user-secrets` (development) or environment variables (production),
# never in a tracked file.
**/appsettings.Local.json
**/appsettings.Production.json
